# Copy to deploy/.env.production on the server. Never commit the real file.
CAMPUS_DOMAIN=copilot.example.com

CAMPUS_LLM_PROVIDER=makers
CAMPUS_LLM_API_KEY=
# CAMPUS_LLM_BASE_URL=https://ai-gateway.edgeone.link/v1
# CAMPUS_LLM_MODEL=@makers/deepseek-v4-flash
# CAMPUS_LLM_TIMEOUT=30

CAMPUS_ENVIRONMENT=production
CAMPUS_TRACE_ENABLED=1
CAMPUS_TRACE_RETENTION_DAYS=30
CAMPUS_PUBLIC_CHAT_LIMIT_PER_HOUR=60

# Keep discovery disabled until a reviewed mainland-China provider is added.
CAMPUS_WEB_SEARCH_PROVIDER=
CAMPUS_WEB_SEARCH_API_KEY=

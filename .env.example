# Copy this file to .env.local and keep the real key only on your machine.
CAMPUS_LLM_PROVIDER=makers
CAMPUS_LLM_API_KEY=

# Optional overrides. The Makers preset already supplies these defaults.
# CAMPUS_LLM_BASE_URL=https://ai-gateway.edgeone.link/v1
# CAMPUS_LLM_MODEL=@makers/deepseek-v4-flash
# CAMPUS_LLM_TIMEOUT=30

# Optional autonomous web discovery. The LLM and search credentials are separate.
# Create a Tavily API key, then enable discovery with both values below.
CAMPUS_WEB_SEARCH_PROVIDER=tavily
CAMPUS_WEB_SEARCH_API_KEY=
# CAMPUS_WEB_SEARCH_TIMEOUT=12

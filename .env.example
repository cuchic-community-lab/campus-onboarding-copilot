# Copy this file to .env.local and keep the real key only on your machine.
CAMPUS_LLM_PROVIDER=makers
CAMPUS_LLM_API_KEY=

# Optional overrides. Presets: makers (EdgeOne网关) / deepseek (DeepSeek开放平台, 默认 deepseek-chat)。
# 例：CAMPUS_LLM_PROVIDER=deepseek
# CAMPUS_LLM_BASE_URL=https://api.deepseek.com
# CAMPUS_LLM_MODEL=deepseek-chat
# CAMPUS_LLM_TIMEOUT=30

# ---- 可选：联网搜索（v1.4）----
# 知识库外的问题（如"麻辣香锅多少钱"）会自动联网搜索。
# 留空 = 关闭联网搜索，未知问题走软拒答（建议问师哥师姐）。
#
# Provider 一：Serper.dev（默认，Serper.dev 兼容格式）：https://serper.dev
#   SEARCH_PROVIDER=serper
#   SEARCH_API_KEY=
#
# Provider 二：博查 AI 搜索（国内服务，Bing 兼容响应格式）：
#   注册：open.bochaai.com，微信扫码登录；在「API Key 管理」页创建 Key（形如 sk-xxxxxx）。
#   免费额度：注册送 1000 次；在「口令兑换」输入口令「博查搜索」再领 1000 次。
#   超出后按量付费：3.6 元/千次。
#   SEARCH_PROVIDER=bocha
#   BOCHA_API_KEY=sk-你的博查key
#
# 网站优先级搜索（v1.4，仅 bocha 生效）：分号 ; 分隔优先级组，组内 | 或 , 分隔域名，
# 最多 3 组；空组 = 该级不限制（全网兜底）。搜索时按组逐级降级：
#   阶段1 include=P1（官方权威）→ 结果≥2 条即用；
#   阶段2 include=P1|P2 → 仍不足则并入第 2 组；
#   阶段3 不加 include → 全网搜索兜底。
# 默认值覆盖中传官方三件套（P1）+ 微信公众号（P2）+ 全网（P3 空），用户可按需修改，
# 但建议 P1 保留中传官方域名。每条结果带 site_tier 标签（official/wechat/web）。
# SEARCH_PRIORITY_SITES=hainan.cuc.edu.cn|cuc.edu.cn|hnzs.cuc.edu.cn;mp.weixin.qq.com;

# ---- XiaohaiGPT specific ----
# Site root auto-detected (walk up until files.json found); override only if needed.
# CAMPUS_SITE_ROOT=D:/CUC_Files/26新生网站
# CAMPUS_DATA_DIR=<repo>/data
# Auto re-index poll interval in seconds (0 = off).
# CAMPUS_AUTO_POLL_SECONDS=60
# LLM-assisted chunking (0=rule-based only, zero-dependency; 1=enhance tags via LLM).
# AI_ASSISTED_CHUNKING=0
# Answerability thresholds (see contract.md section 5).
# 默认 v1.2：SCORE_FLOOR=0.06 / COVERAGE_FLOOR=0.22 / MIN_EVIDENCE=2。
# 强相关问题（如"宿舍是几人间"）仍可答出；弱相关/检索不足更倾向拒答。
# ANSWERABILITY_SCORE_FLOOR=0.06
# ANSWERABILITY_COVERAGE_FLOOR=0.22
# ANSWERABILITY_MIN_EVIDENCE=2
# ---- 术语表注入（v1.5）----
# TERMS_ENABLED=1（默认）开启术语表功能：生成层注入【校园语境】+ 检索层 query 改写；
# =0 完全关闭。术语表文件 config/terms.json（用户可自行维护，缺失/损坏自动降级为空表）。
# TERMS_ENABLED=1
# Senior Q&A admin token (used by POST /api/senior/reply and /api/senior/pending).
# 同时也是管理后台（admin.html）的登录密码：前端拿它调 /api/senior/pending 校验（200=通过，401=密码错）。
# 未配置时默认 dev-senior-token（公开可猜，生产必须改）。
# SENIOR_ADMIN_TOKEN=dev-senior-token
